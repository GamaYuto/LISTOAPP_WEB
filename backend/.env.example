# Server Configuration
PORT=3000

# CORS & Frontend URL (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173

# Base URL for public API endpoints and uploaded assets
API_URL=http://localhost:3000

# Database Configuration (Turso / LibSQL)
# For remote Turso: libsql://[db-name]-[org].turso.io
# For local SQLite: file:./dev.db
DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-change-in-production
