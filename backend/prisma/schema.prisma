generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}



model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String
  role             String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  clientRequests   ServiceRequest[] @relation("ClientRequests")
  providerRequests ServiceRequest[] @relation("ProviderRequests")
  offers           Offer[]          @relation("ProviderOffers")
}

model ServiceRequest {
  id             String        @id @default(uuid())
  clientId       String
  client         User          @relation("ClientRequests", fields: [clientId], references: [id])
  providerId     String?
  provider       User?         @relation("ProviderRequests", fields: [providerId], references: [id])
  title          String
  description    String
  category       String
  priceSuggested Float
  status         String @default("PENDING")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  offers         Offer[]
}

model Offer {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  providerId       String
  provider         User           @relation("ProviderOffers", fields: [providerId], references: [id])
  priceOffered     Float
  comment          String?
  status           String    @default("PENDING")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model WindowQuoteRequest {
  id              String   @id @default(uuid())
  fullName        String
  email           String
  phone           String
  serviceCategory String
  details         String
  dimensions      String?
  imageUrl        String?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}
